# Dependencies and package managers
node_modules
.pnpm-store
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Build output
.next
out
build
dist
*.tsbuildinfo

# Git and CI/CD
.git
.gitignore
.gitattributes
.github

# Environment files and credentials (never include in image context)
.env*
!.env.example
!server/.env.example

# Local databases and runtime data
data
*.db
*.db-journal
*.db-wal
*.db-shm

# Legacy app
legacy-next

# Tests and fixtures
coverage
test-*.ts
test*.ts

# IDE, OS, and editor files
.vscode
.idea
.DS_Store
*.swp
*.swo

# Docker and Compose definitions (avoid invalidating context on compose edits)
docker-compose*.yml
docker-compose*.yaml
Dockerfile*

# Documentation
*.md
docs/
