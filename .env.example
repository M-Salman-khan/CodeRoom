# ---------------------------------------------------------------------------
# CodeRoom environment (copy to .env for local development)
# ---------------------------------------------------------------------------

# MongoDB (local service or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/coderoom

# JWT signing secret — must be at least 32 characters in production.
# Generate one with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# API / WebSocket server
PORT=3000
HOST=0.0.0.0

# Vite dev server origin (only needed for cross-origin dev requests)
CLIENT_ORIGIN=http://localhost:5173

# Canonical public origin used to build invitation links.
# Production: https://coderoom.example.com (required for shareable links)
# Leave empty locally; join links stay disabled instead of emitting localhost.
PUBLIC_BASE_URL=

# Additional exact CORS origins (comma-separated), usually unnecessary because
# PUBLIC_BASE_URL and CLIENT_ORIGIN are added automatically.
ALLOWED_ORIGINS=

# Number of trusted reverse-proxy hops. Use 1 behind Caddy/Nginx, 0 for direct.
TRUST_PROXY=0

# Development-only escape hatch for intentionally sharing a private/local URL.
# Never enable this on an internet-facing deployment.
ALLOW_PRIVATE_BASE_URL=false

# Optional AI providers (the built-in heuristic engine works without keys)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Set to true on first container start to load demo users + room
SEED_DATABASE=false
