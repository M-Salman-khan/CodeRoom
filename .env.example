# ---------------------------------------------------------------------------
# CodeRoom environment (copy to .env for local development)
# ---------------------------------------------------------------------------

# MongoDB (local service or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/coderoom

# JWT signing secret — must be at least 32 characters in production
AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# API / WebSocket server
PORT=3000
HOST=0.0.0.0

# Vite dev server origin (only needed for cross-origin dev requests)
CLIENT_ORIGIN=http://localhost:5173

# Optional AI providers (the built-in heuristic engine works without keys)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Set to true on first container start to load demo users + room
SEED_DATABASE=false
