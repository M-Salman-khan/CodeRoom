{
  "name": "coderoom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx -r ./src/server/polyfill.js server.ts",
    "dev:next": "next dev",
    "build": "prisma generate && next build",
    "start": "NODE_ENV=production tsx -r ./src/server/polyfill.js server.ts",
    "lint": "next lint",
    "test": "tsx test-coderoom.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "docker:build": "docker build -t coderoom .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.10",
    "lib0": "^0.2.117",
    "lucide-react": "^1.40.0",
    "next": "14.2.15",
    "prisma": "6.19.3",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.13",
    "ws": "^8.21.3",
    "y-monaco": "^0.1.6",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/ws": "^8.18.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.15",
    "monaco-editor": "^0.56.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
