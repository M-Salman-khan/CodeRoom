# ==============================================================================
# CodeRoom Docker / production environment (copy to .env on the server)
# ==============================================================================

# Public hostname only (no protocol, no path). DNS must point at this server.
DOMAIN=coderoom.example.com

# Canonical public origin used for invitation links and CORS. Must be HTTPS.
PUBLIC_BASE_URL=https://coderoom.example.com

# Exact browser origin allowed by CORS (normally identical to PUBLIC_BASE_URL).
CLIENT_ORIGIN=https://coderoom.example.com

# Additional CORS origins, comma-separated. Usually empty.
ALLOWED_ORIGINS=

# Secret key used for signing JWT sessions. Generate with:
#   openssl rand -base64 48
# The server refuses to start in production with the development fallback.
AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Reverse-proxy hops. 1 when Caddy/Nginx runs in front of the app.
TRUST_PROXY=1

# Port exposed internally by the app container (loopback only in compose).
PORT=3000

# Mongo connection used by the app container. The bundled compose file runs
# MongoDB as the `mongo` service; point this at Atlas/another host if preferred.
MONGODB_URI=mongodb://mongo:27017/coderoom

# Optional AI providers
GEMINI_API_KEY=
OPENAI_API_KEY=

# Set to "true" to seed demo accounts (demo/password123, collaborator/password123)
SEED_DATABASE=false
