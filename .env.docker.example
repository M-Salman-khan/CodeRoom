# ==============================================================================
# CodeRoom Docker Environment Configuration
# ==============================================================================

# Port exposed by the app container
PORT=3000

# Secret key used for signing JWT sessions (minimum 32 characters)
AUTH_SECRET=coderoom-lan-super-secret-key-at-least-32-chars-long

# Public application origin (used by CORS in production)
# For LAN: http://<your-lan-ip>:3000   |   For a VPS: https://coderoom.yourdomain.com
CLIENT_ORIGIN=http://localhost:3000

# Mongo connection used by the app container. The bundled compose file runs
# MongoDB as the `mongo` service; point this at Atlas/another host if preferred.
MONGODB_URI=mongodb://mongo:27017/coderoom

# Optional AI providers
GEMINI_API_KEY=
OPENAI_API_KEY=

# Set to "true" to seed demo accounts (demo/password123, collaborator/password123)
SEED_DATABASE=false
