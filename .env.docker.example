# ==============================================================================
# CodeRoom Docker Environment Configuration
# ==============================================================================

# Port to expose on the host
PORT=3000

# Secret key used for signing JWT authentication session cookies (minimum 32 characters)
AUTH_SECRET=coderoom-lan-super-secret-key-at-least-32-chars-long

# Public application URL (used for sharing room links and invites)
# For LAN: http://<your-lan-ip>:3000 (e.g. http://192.168.1.105:3000)
# For Domain/VPS: https://coderoom.yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to "true" to automatically seed initial demo accounts (demo/password123, collaborator/password123)
SEED_DATABASE=false
